<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground.

  A plain reference rather than an <inset>: the bitmap is already padded to
  the 72dp safe zone (see tools/generate_logo_assets.py), so wrapping it in
  another inset would shrink the mark twice - which is exactly what the old
  ic_launcher_foreground.xml did, with a 12dp inset on top of the wordmark's
  own margin, leaving the F noticeably undersized.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_fastpay_logo_foreground" />