<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 13+ themed (monochrome) launcher icon.

  The system tints this drawable, so only the silhouette survives. Generated by
  flattening the master's alpha channel; keeping it at the same geometry as the
  colour foreground is deliberate, so switching a launcher to themed icons does
  not make the icon appear to resize.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_fastpay_logo_mono" />